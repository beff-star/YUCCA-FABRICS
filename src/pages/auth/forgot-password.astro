---
import { and, eq } from 'drizzle-orm';
import AuthLayout from '~/layouts/AuthLayout.astro';
import { auth } from '~/lib/auth';
import { db, schema } from '~/lib/db';
import { allow, clientIp } from '~/lib/throttle';

let error = '';
let sent = false;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim().toLowerCase();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    error = 'Enter a valid email address.';
  } else if (!(await allow(`reset:${clientIp(Astro.request)}`, 5, 15 * 60))) {
    error = 'Too many requests. Please wait a few minutes and try again.';
  } else {
    const [account] = await db.select({ id: schema.user.id }).from(schema.user)
      .where(and(eq(schema.user.email, email), eq(schema.user.status, 'active')));
    // Only active accounts get an email, but the reply is the same either way so emails can't be probed.
    if (account) await auth.api.requestPasswordReset({ body: { email }, headers: Astro.request.headers });
    sent = true;
  }
}
---
<AuthLayout title="Reset your password" eyebrow="Account help" heading="Forgot your password?" intro="Enter the email you registered with and we’ll send you a link to choose a new password." errors={error ? [error] : []} success={sent ? 'If that email belongs to an account, a reset link is on its way. It expires in one hour.' : undefined}>
  <form method="post" class="grid gap-5">
    <label class="text-sm font-medium">Email<input class="form-control mt-1" type="email" name="email" required autocomplete="email" /></label>
    <button class="rounded-full bg-forest px-6 py-3.5 font-semibold text-white transition hover:bg-olive">Send reset link</button>
  </form>
  <p class="mt-8 rounded-2xl bg-cream p-4 text-center text-sm">Remembered it? <a class="font-semibold text-forest underline" href="/auth/login">Sign in</a></p>
</AuthLayout>
