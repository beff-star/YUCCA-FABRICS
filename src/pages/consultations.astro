---
import { actions } from 'astro:actions';
import FormResult from '~/components/FormResult.astro';
import Icon from '~/components/Icon.astro';
import ServiceCard from '~/components/ServiceCard.astro';
import YuccaSprig from '~/components/YuccaSprig.astro';
import { fabricCollection } from '~/data/fabric-collection';
import { BUDGET_RANGES, CONSULTATION_TIMES, CONSULTATION_TYPES, PROPERTY_TYPES, serviceImage } from '~/data/service-details';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { formatClock, todayInNairobi } from '~/lib/format';
import { formatMoneyWhole } from '~/lib/money';
import { activeServices } from '~/lib/services';
import { getSettings, setting, whatsappUrl } from '~/lib/settings';

const consultations = await activeServices(true);
const settings = await getSettings(Astro.locals);
const prices = consultations.map((s) => s.startingPriceCents).filter((p): p is number => p !== null);
const durations = [...new Set(consultations.map((s) => s.duration).filter(Boolean))];
const requested = Astro.url.searchParams.get('type') ?? '';
const selectedType = (CONSULTATION_TYPES as readonly string[]).includes(requested) ? requested : '';
const hours = setting(settings, 'business_hours');
const helpAreas = [
  ['fa6-solid:house', '#1F5B43', 'text-white', 'Homes', 'Living rooms, bedrooms, home offices and the spaces in between, planned around how your household really lives.'],
  ['fa6-solid:building', '#16646E', 'text-white', 'Commercial spaces', 'Hospitality, retail and workspaces that need to impress on day one and stand up to daily use.'],
  ['fa6-solid:palette', '#A9461E', 'text-white', 'Fabric & colour', 'Texture, colour coordination, curtains and upholstery materials that work together across a room.'],
  ['fa6-solid:couch', '#E3A82B', 'text-ink', 'Layout & furnishing', 'Making the most of what you have, and knowing exactly what to add, move or let go.'],
];
const steps = [
  ['fa6-solid:calendar-check', 'Request a slot', 'Pick a date, a time and online or in person using the form below.'],
  ['fa6-solid:envelope-open-text', 'We confirm', 'We check the slot and confirm your appointment with you before it is final.'],
  ['fa6-solid:comments', 'Let’s talk it through', 'We look at your space, photos and ideas together, and ask the right questions.'],
  ['fa6-solid:lightbulb', 'Your next steps', 'You leave with fabric, colour and layout suggestions you can act on.'],
];
const prepare = [
  ['fa6-solid:camera', 'Photos of the room', 'A few wide shots in daylight, plus any pieces you’re unsure about.'],
  ['fa6-solid:ruler-combined', 'Rough measurements', 'Wall lengths, window sizes and the furniture you plan to keep.'],
  ['fa6-solid:images', 'Inspiration you love', 'Screenshots, magazine pages or a fabric you’ve spotted in our shop.'],
  ['fa6-solid:wallet', 'A budget range', 'Even a rough figure helps us focus on what will make the biggest difference.'],
];
const fileInput = 'form-control mt-1 text-sm file:mr-3 file:rounded-full file:border-0 file:bg-cream file:px-4 file:py-1.5 file:text-sm file:font-semibold file:text-forest';
---
<BaseLayout title="Interior Design Consultation in Nairobi | Yucca Homeware" description="Book an interior design consultation with Yucca Homeware in Nairobi or online: fabric and colour advice, room styling and layout for homes across Kenya.">
  <section class="relative grid overflow-hidden bg-forest text-white lg:min-h-[560px] lg:grid-cols-2">
    <YuccaSprig class="pointer-events-none absolute -left-16 bottom-0 h-80 w-80 text-white/5" />
    <div class="relative flex flex-col justify-center px-5 py-16 sm:px-8 lg:py-20 lg:pl-[max(1.25rem,calc((100vw-80rem)/2+1.25rem))]">
      <p class="eyebrow">Interior design consultations</p>
      <h1 class="mt-4 font-serif text-4xl leading-[1.1] sm:text-5xl lg:text-6xl">A room that feels<br /><span class="text-wheat">like it’s yours.</span></h1>
      <p class="mt-6 max-w-lg text-base leading-8 text-white/85">Talk through colour, fabric, layout and furnishing with a thoughtful design partner. Online or in person, we begin with what matters to you and finish with a plan you can act on.</p>
      <div class="mt-8 flex flex-wrap gap-3"><a href="#book" class="rounded-full bg-wheat px-6 py-3 text-sm font-semibold text-night shadow-md transition hover:bg-white">Book a consultation</a>{consultations.length > 0 && <a href="#packages" class="rounded-full border border-white/40 px-6 py-3 text-sm font-semibold transition hover:bg-white/10">Compare sessions</a>}</div>
      <ul class="mt-10 flex flex-wrap gap-3 text-xs font-medium">
        <li class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 ring-1 ring-white/15"><Icon name="fa6-solid:video" class="text-wheat" />Online or in person</li>
        {durations.length > 0 && <li class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 ring-1 ring-white/15"><Icon name="fa6-solid:clock" class="text-wheat" />{durations.join(' or ')}</li>}
        {prices.length > 0 && <li class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 ring-1 ring-white/15"><Icon name="fa6-solid:tag" class="text-wheat" />From {formatMoneyWhole(Math.min(...prices))}</li>}
      </ul>
    </div>
    <div class="relative min-h-[320px]">
      <img src={serviceImage('consultation-material-samples.jpg')} alt="A designer arranging fabric and material samples on a desk" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute bottom-5 left-5 right-5 flex items-center gap-3 rounded-2xl bg-white/95 p-4 text-ink shadow-xl sm:left-auto sm:max-w-xs"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-teal text-white"><Icon name="fa6-solid:swatchbook" /></span><span class="text-xs leading-5 text-gray-600"><strong class="block text-sm text-ink">Samples at hand</strong>Compare {fabricCollection.length} textures from our collection</span></div>
    </div>
  </section>

  {consultations.length > 0 && (
    <section id="packages" class="py-20">
      <div class="mx-auto max-w-7xl px-5">
        <div class="mx-auto max-w-2xl text-center"><p class="eyebrow">Choose your session</p><h2 class="mt-3 font-serif text-4xl sm:text-5xl">Advice shaped around your space</h2><p class="mt-4 text-sm leading-7 text-gray-600">Start with the fabric, or step back and plan the whole room. Either way you’ll talk to someone who knows how materials look, feel and wear at home.</p></div>
        <div class="mx-auto mt-14 grid max-w-5xl gap-8 md:grid-cols-2">{consultations.map((service) => <ServiceCard service={service} />)}</div>
        <p class="mx-auto mt-10 max-w-2xl text-center text-sm text-gray-600">Want to learn the principles yourself? <a class="font-semibold text-forest underline" href="/classes">Book a virtual interior design class</a> by the hour.</p>
      </div>
    </section>
  )}

  <section class="bg-cream py-20">
    <div class="mx-auto max-w-7xl px-5">
      <div class="max-w-2xl"><p class="eyebrow">What we can help with</p><h2 class="mt-3 font-serif text-4xl">Every room has its own story</h2></div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {helpAreas.map(([icon, colour, iconText, title, text]) => <article class="rounded-3xl bg-white p-7 shadow-sm ring-1 ring-ink/5 transition motion-safe:hover:-translate-y-1 hover:shadow-lg"><span class:list={['grid h-14 w-14 place-items-center rounded-2xl text-xl', iconText]} style={`background-color:${colour}`}><Icon name={icon!} /></span><h3 class="mt-6 font-serif text-xl">{title}</h3><p class="mt-3 text-sm leading-6 text-gray-600">{text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="mx-auto max-w-7xl px-5">
      <div class="mx-auto max-w-2xl text-center"><p class="eyebrow">How it works</p><h2 class="mt-3 font-serif text-4xl">Four simple steps</h2></div>
      <ol class="relative mt-14 grid gap-10 md:grid-cols-4 md:gap-6">
        <span class="absolute left-[12.5%] right-[12.5%] top-8 hidden h-0.5 bg-gradient-to-r from-pine via-mustard to-terracotta md:block" aria-hidden="true"></span>
        {steps.map(([icon, title, text], index) => <li class="relative text-center"><span class="relative mx-auto grid h-16 w-16 place-items-center rounded-full bg-white text-xl text-forest shadow-lg ring-4 ring-sand"><Icon name={icon!} /><span class="absolute -right-1 -top-1 grid h-6 w-6 place-items-center rounded-full bg-clay text-[11px] font-bold text-white">{index + 1}</span></span><h3 class="mt-5 text-lg font-semibold">{title}</h3><p class="mx-auto mt-2 max-w-xs text-sm leading-6 text-gray-600">{text}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="relative overflow-hidden bg-night py-20 text-white">
    <YuccaSprig class="pointer-events-none absolute -right-16 -top-16 h-96 w-96 text-white/5" />
    <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-5 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Before we meet</p>
        <h2 class="mt-3 font-serif text-4xl">How to prepare</h2>
        <p class="mt-4 max-w-lg text-sm leading-7 text-cream/80">None of this is required, but a little preparation helps us make the most of your time together.</p>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {prepare.map(([icon, title, text]) => <li class="rounded-2xl bg-white/5 p-5 ring-1 ring-white/10"><Icon name={icon!} class="text-xl text-wheat" /><h3 class="mt-3 font-semibold">{title}</h3><p class="mt-1 text-sm leading-6 text-cream/80">{text}</p></li>)}
        </ul>
      </div>
      <img src={serviceImage('design-desk-swatches.jpg')} alt="Fabric swatches and sketches laid out on a design desk" loading="lazy" class="aspect-square w-full rounded-3xl object-cover shadow-2xl" />
    </div>
  </section>

  <section id="book" class="bg-cream py-20">
    <div class="mx-auto max-w-7xl px-5">
      <div class="overflow-hidden rounded-3xl bg-white shadow-xl shadow-ink/10 lg:grid lg:grid-cols-[.8fr_1.2fr]">
        <aside class="relative overflow-hidden bg-teal p-8 text-white sm:p-10">
          <YuccaSprig class="pointer-events-none absolute -bottom-10 -right-10 h-64 w-64 text-white/10" />
          <div class="relative">
            <p class="text-[11px] font-semibold uppercase tracking-[.22em] text-white/90">Let’s make a plan</p>
            <h2 class="mt-3 font-serif text-4xl">Request a consultation</h2>
            <p class="mt-4 text-sm leading-7 text-white/90">Choose a preferred slot and we’ll confirm it with you before your appointment is final. A slot can only be held once, so if your first choice has just been taken, please pick another.</p>
            <ul class="mt-8 grid gap-4 text-sm">
              <li class="flex gap-3"><Icon name="fa6-solid:video" class="mt-1 shrink-0" /><span>Meet online from anywhere, or in person.</span></li>
              <li class="flex gap-3"><Icon name="fa6-solid:calendar-check" class="mt-1 shrink-0" /><span>Appointments during opening hours{hours && `: ${hours}`}.</span></li>
              <li class="flex gap-3"><Icon name="fa6-solid:camera" class="mt-1 shrink-0" /><span>Add a photo so we can prepare in advance.</span></li>
            </ul>
            <a href={whatsappUrl(settings)} target="_blank" rel="noopener" class="mt-10 inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-teal"><Icon name="fa6-brands:whatsapp" />Questions? WhatsApp us</a>
          </div>
        </aside>
        <form data-ajax-form="consultation" action={actions.consultation} enctype="multipart/form-data" method="post" class="grid gap-4 p-8 sm:grid-cols-2 sm:p-10">
          <FormResult action={actions.consultation} class="sm:col-span-2" />
          <label class="text-sm font-medium">Full name<input class="form-control mt-1" name="name" required maxlength="150" autocomplete="name" /></label>
          <label class="text-sm font-medium">Email<input class="form-control mt-1" type="email" name="email" required autocomplete="email" /></label>
          <label class="text-sm font-medium">Phone<input class="form-control mt-1" type="tel" name="phone" required autocomplete="tel" /></label>
          <label class="text-sm font-medium">Consultation type<select id="consultation-type" class="form-control mt-1" name="consultation_type" required><option value="">Choose one</option>{CONSULTATION_TYPES.map((type) => <option selected={type === selectedType}>{type}</option>)}</select></label>
          <label class="text-sm font-medium">Property type<select class="form-control mt-1" name="property_type" required><option value="">Choose one</option>{PROPERTY_TYPES.map((type) => <option>{type}</option>)}</select></label>
          <label class="text-sm font-medium">Property location<input class="form-control mt-1" name="location" required maxlength="255" /></label>
          <label class="text-sm font-medium">Preferred date<input class="form-control mt-1" type="date" name="preferred_date" min={todayInNairobi()} required /></label>
          <label class="text-sm font-medium">Preferred time<select class="form-control mt-1" name="preferred_time" required><option value="">Choose a time</option>{CONSULTATION_TIMES.map((time) => <option value={time}>{formatClock(time)}</option>)}</select></label>
          <label class="text-sm font-medium">Budget range (optional)<select class="form-control mt-1" name="budget"><option value="">Prefer not to say</option>{BUDGET_RANGES.map((range) => <option>{range}</option>)}</select></label>
          <label class="text-sm font-medium">Consultation method<select class="form-control mt-1" name="method" required><option value="online">Online</option><option value="in_person">In person</option></select></label>
          <label class="text-sm font-medium sm:col-span-2">Project description<textarea class="form-control mt-1" name="description" rows="4" minlength="10" maxlength="5000" required placeholder="Tell us about the space, what you’d like to change and anything you want to keep."></textarea></label>
          <label class="text-sm font-medium sm:col-span-2">Reference photo (optional)<input class={fileInput} type="file" name="reference_image" accept="image/jpeg,image/png,image/webp" /></label>
          <button class="btn-primary w-fit shadow-md sm:col-span-2">Request my consultation <Icon name="fa6-solid:calendar-check" class="text-xs" /></button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
