---
import Icon from '~/components/Icon.astro';
import JournalCard from '~/components/JournalCard.astro';
import Pagination from '~/components/Pagination.astro';
import YuccaSprig from '~/components/YuccaSprig.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { formatLongDate, readMinutes } from '~/lib/format';
import { journalCategories, journalImage, listPosts } from '~/lib/journal';

const params = Astro.url.searchParams;
const q = (params.get('q') ?? '').trim().slice(0, 80);
const categories = await journalCategories();
const active = categories.find((category) => category.slug === params.get('category')) ?? null;
const result = await listPosts({ q, category: active?.slug ?? '', page: Number.parseInt(params.get('page') ?? '1', 10) || 1 });
const posts = [...result.posts];
// The newest story is featured on the unfiltered first page.
const featured = result.page === 1 && !q && !active ? posts.shift() ?? null : null;
const listUrl = (query: Record<string, string>) => {
  const search = new URLSearchParams(Object.entries(query).filter(([, v]) => v)).toString();
  return search ? `/journal?${search}` : '/journal';
};
---
<BaseLayout title="Fabric, Upholstery & Interior Ideas Journal | Yucca Homeware" description="Practical advice on choosing upholstery fabrics, caring for furniture and styling a home in Kenya, from the Yucca Homeware team in Nairobi.">
  <section class="relative overflow-hidden bg-cream px-5 py-16 text-center">
    <YuccaSprig class="pointer-events-none absolute -left-16 -top-10 hidden h-72 w-72 text-olive/10 sm:block" />
    <YuccaSprig class="pointer-events-none absolute -bottom-16 -right-16 hidden h-72 w-72 text-clay/10 sm:block" />
    <div class="relative">
      <p class="eyebrow">The Yucca journal</p><h1 class="mt-3 font-serif text-4xl sm:text-5xl">Notes on making a home</h1>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-gray-600">Practical ideas for choosing fabrics, caring for furniture and making a space feel a little more like you.</p>
      <form class="mx-auto mt-8 flex max-w-md gap-2" role="search">
        <label class="sr-only" for="journal-search">Search the journal</label>
        <input id="journal-search" class="form-control rounded-full px-5" type="search" name="q" value={q} placeholder="Search the journal" />
        {active && <input type="hidden" name="category" value={active.slug} />}
        <button class="grid shrink-0 place-items-center rounded-full bg-forest px-5 text-sm font-semibold text-white transition hover:bg-olive" aria-label="Search"><Icon name="fa6-solid:magnifying-glass" /></button>
      </form>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-5 py-12">
    {categories.length > 0 && (
      <nav class="mb-10 flex flex-wrap justify-center gap-2" aria-label="Journal categories">
        <a class:list={['rounded-full px-4 py-2 text-xs font-semibold transition', !active ? 'bg-forest text-white' : 'bg-white text-ink hover:bg-cream']} href={listUrl({ q })} aria-current={!active ? 'page' : undefined}>All stories</a>
        {categories.map((category) => <a class:list={['rounded-full px-4 py-2 text-xs font-semibold transition', active?.slug === category.slug ? 'bg-forest text-white' : 'bg-white text-ink hover:bg-cream']} href={listUrl({ category: category.slug, q })} aria-current={active?.slug === category.slug ? 'page' : undefined}>{category.name}</a>)}
      </nav>
    )}
    {q && <p class="mb-6 text-sm text-gray-600">Results for “{q}” · <a class="underline" href={listUrl({ category: active?.slug ?? '' })}>Clear search</a></p>}
    {featured && (
      <article class="group mb-10 grid overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-ink/5 lg:grid-cols-2">
        <a href={`/journal/${featured.slug}`} class="relative block aspect-[16/10] overflow-hidden lg:aspect-auto lg:min-h-[420px]" tabindex="-1" aria-hidden="true"><img class="absolute inset-0 h-full w-full object-cover motion-safe:transition motion-safe:duration-700 motion-safe:group-hover:scale-105" src={journalImage(featured.image)} alt="" /><span class="absolute left-5 top-5 rounded-full bg-clay px-3 py-1 text-[10px] font-semibold uppercase tracking-[.16em] text-white">Latest story</span></a>
        <div class="flex flex-col justify-center p-8 sm:p-12">
          <p class="eyebrow">{featured.categoryName ?? 'Yucca notes'}</p>
          <h2 class="mt-3 font-serif text-3xl leading-tight sm:text-4xl"><a class="transition hover:text-forest" href={`/journal/${featured.slug}`}>{featured.title}</a></h2>
          <p class="mt-4 text-sm leading-7 text-gray-600">{featured.excerpt}</p>
          <p class="mt-5 text-xs text-gray-500">{featured.publishedAt && formatLongDate(featured.publishedAt)} · {readMinutes(featured.body)} min read</p>
          <a href={`/journal/${featured.slug}`} class="btn-primary mt-7 w-fit">Read the story <Icon name="fa6-solid:arrow-right" class="text-xs" /></a>
        </div>
      </article>
    )}
    {posts.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{posts.map((post) => <JournalCard post={post} />)}</div>
    ) : !featured && (
      <div class="rounded-3xl bg-white px-6 py-16 text-center"><Icon name="fa6-regular:newspaper" class="text-3xl text-sage" /><h2 class="mt-4 font-serif text-2xl">{q || active ? 'No stories match yet' : 'Good stories are on their way'}</h2><p class="mt-3 text-sm text-gray-600">We’ll be sharing ideas from the world of fabrics, furniture and home.</p>{(q || active) && <a class="mt-5 inline-block text-sm font-semibold underline" href="/journal">See all stories</a>}</div>
    )}
    <Pagination page={result.page} pages={result.pages} />
  </section>
</BaseLayout>
