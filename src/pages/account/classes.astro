---
import { desc, eq } from 'drizzle-orm';
import Icon from '~/components/Icon.astro';
import StatusBadge from '~/components/StatusBadge.astro';
import { PLATFORM_LABELS } from '~/data/courses';
import AccountLayout from '~/layouts/AccountLayout.astro';
import { db, schema } from '~/lib/db';
import { formatLongDate, formatTime } from '~/lib/format';
import { formatMoney } from '~/lib/money';

const t = schema.trainingBookings;
const rows = await db.select({ booking: t, title: schema.trainingCourses.title })
  .from(t).innerJoin(schema.trainingCourses, eq(schema.trainingCourses.id, t.courseId))
  .where(eq(t.userId, Astro.locals.user!.id)).orderBy(desc(t.startsAt));
const now = Date.now();
const JOIN_EARLY_MS = 15 * 60_000;
const upcoming = rows.filter(({ booking }) => booking.status === 'confirmed' && booking.startsAt.getTime() + booking.hours * 3_600_000 > now);
const past = rows.filter((row) => !upcoming.includes(row));
---
<AccountLayout active="classes" heading="Your virtual classes" intro="Upcoming sessions, meeting links and past bookings." action={{ label: 'Book a class', href: '/classes#book', icon: 'fa6-solid:plus' }}>
  {rows.length === 0 ? (
    <div class="rounded-3xl bg-white px-6 py-16 text-center shadow-sm ring-1 ring-ink/5"><Icon name="fa6-solid:chalkboard-user" class="text-3xl text-sage" /><h2 class="mt-4 font-serif text-2xl">No classes yet</h2><p class="mt-2 text-sm text-gray-600">Learn furniture, upholstery or interior design live with Yucca Homeware Consultant.</p><a class="btn-primary mt-6" href="/classes">Explore the classes</a></div>
  ) : (
    <>
      {upcoming.length > 0 && (
        <div class="grid gap-4">
          {upcoming.map(({ booking, title }) => {
            const joinable = Boolean(booking.meetingUrl) && booking.startsAt.getTime() - now <= JOIN_EARLY_MS;
            return (
              <article class="rounded-3xl bg-night p-6 text-white shadow-sm">
                <div class="flex flex-wrap items-start justify-between gap-3"><div><p class="eyebrow">Upcoming</p><h2 class="mt-2 font-serif text-2xl">{title}</h2><p class="mt-1 text-sm text-white/85">{formatLongDate(booking.startsAt)} · {formatTime(booking.startsAt)} (EAT) · {booking.hours} {booking.hours === 1 ? 'hour' : 'hours'} on {PLATFORM_LABELS[booking.platform]}</p></div></div>
                <div class="mt-5 flex flex-wrap gap-3">
                  {booking.meetingUrl
                    ? <a href={booking.meetingUrl} target="_blank" rel="noopener" class:list={['inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold', joinable ? 'bg-wheat text-night' : 'bg-white/10 text-white ring-1 ring-white/20']}><Icon name="fa6-solid:video" />{joinable ? 'Join now' : 'Meeting link'}</a>
                    : <span class="text-sm text-white/80">{booking.platform === 'whatsapp' ? 'We’ll video-call you on WhatsApp at the start time.' : 'Your meeting link will appear here before the session.'}</span>}
                  <a href={`/classes/booking/${booking.reference}`} class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold text-wheat hover:underline">Booking details <Icon name="fa6-solid:arrow-right" class="text-xs" /></a>
                </div>
              </article>
            );
          })}
        </div>
      )}
      {past.length > 0 && (
        <div class="mt-8 overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-ink/5">
          <h2 class="px-6 pt-6 font-serif text-xl">Other bookings</h2>
          <ul class="mt-2 divide-y divide-ink/10">
            {past.map(({ booking, title }) => (
              <li><a href={`/classes/booking/${booking.reference}`} class="grid gap-2 px-6 py-4 transition hover:bg-sand sm:grid-cols-[1fr_auto] sm:items-center"><span><span class="block font-semibold">{title}</span><span class="text-xs text-gray-500">{formatLongDate(booking.startsAt)} · {booking.reference}</span></span><span class="flex items-center gap-3"><StatusBadge status={booking.status} /><span class="text-sm font-semibold">{formatMoney(booking.totalCents)}</span></span></a></li>
            ))}
          </ul>
        </div>
      )}
    </>
  )}
</AccountLayout>
