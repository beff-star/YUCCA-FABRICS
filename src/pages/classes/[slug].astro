---
import BookingForm from '~/components/BookingForm.astro';
import CourseCard from '~/components/CourseCard.astro';
import Icon from '~/components/Icon.astro';
import YuccaSprig from '~/components/YuccaSprig.astro';
import { BOOKING_GUIDELINES, courseLook, LEVEL_LABELS, tracks } from '~/data/courses';
import { serviceImage } from '~/data/service-details';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { formatMoneyWhole } from '~/lib/money';
import { absoluteUrl, breadcrumbJsonLd, businessId, siteOrigin } from '~/lib/seo';
import { activeCourses } from '~/lib/training';

const courses = await activeCourses();
const course = courses.find((item) => item.slug === Astro.params.slug);
if (!course) return Astro.rewrite('/404');
const track = tracks[course.track];
const look = courseLook(course.slug);
const others = [...courses.filter((c) => c.id !== course.id && c.track === course.track), ...courses.filter((c) => c.track !== course.track)].slice(0, 3);
const origin = siteOrigin(Astro.url);
const url = absoluteUrl(`/classes/${course.slug}`, origin);
const structuredData = [{
  '@context': 'https://schema.org', '@type': 'Course', name: course.title, description: course.summary, url, inLanguage: 'en',
  teaches: course.outcomes, educationalLevel: course.level,
  provider: { '@type': 'Organization', name: 'Yucca Homeware Consultant', url: absoluteUrl('/', origin), parentOrganization: { '@id': businessId(origin) } },
  offers: { '@type': 'Offer', category: 'Paid', price: (course.hourlyRateCents / 100).toFixed(0), priceCurrency: 'KES', url: `${url}#book` },
  hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online', courseWorkload: 'PT1H' },
}, breadcrumbJsonLd(origin, [['Virtual classes', '/classes'], [course.title, `/classes/${course.slug}`]])];
---
<BaseLayout title={`${course.title} · virtual class | Yucca Homeware`} description={`${course.summary} Live online, ${formatMoneyWhole(course.hourlyRateCents)} per hour.`} image={serviceImage(look.image)} structuredData={structuredData}>
  <section class="relative overflow-hidden text-white" style={`background-color:${track.bg}`}>
    <YuccaSprig class="pointer-events-none absolute -bottom-24 -left-16 h-96 w-96 text-white/5" />
    <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-5 py-14 lg:grid-cols-[1.1fr_.9fr] lg:py-20">
      <div>
        <nav aria-label="Breadcrumb"><ol class="flex flex-wrap items-center gap-2 text-xs text-white/85"><li><a class="hover:text-white hover:underline" href="/classes">Virtual classes</a></li><li aria-hidden="true"><Icon name="fa6-solid:chevron-right" class="text-[9px]" /></li><li><a class="hover:text-white hover:underline" href={`/classes?track=${course.track}#courses`}>{track.label}</a></li></ol></nav>
        <h1 class="mt-5 font-serif text-4xl leading-[1.1] sm:text-5xl">{course.title}</h1>
        <p class="mt-5 max-w-xl text-base leading-8 text-white/90">{course.summary}</p>
        <ul class="mt-8 flex flex-wrap gap-3 text-xs font-medium">
          <li class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-2 ring-1 ring-white/20"><Icon name="fa6-solid:tag" />{formatMoneyWhole(course.hourlyRateCents)} per hour</li>
          <li class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-2 ring-1 ring-white/20"><Icon name="fa6-solid:signal" />{LEVEL_LABELS[course.level]}</li>
          <li class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-2 ring-1 ring-white/20"><Icon name="fa6-solid:video" />Live on Meet, Zoom or WhatsApp</li>
        </ul>
        <a href="#book" class="mt-8 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold shadow-md transition hover:bg-sand" style={`color:${track.bg}`}>Book this course <Icon name="fa6-solid:arrow-right" class="text-xs" /></a>
      </div>
      <div class="relative mx-auto w-full max-w-md">
        <img src={serviceImage(look.image)} alt={look.imageAlt} class="aspect-[4/5] w-full rounded-3xl object-cover shadow-2xl" fetchpriority="high" />
        <span class="absolute -bottom-6 -left-6 grid h-20 w-20 place-items-center rounded-3xl bg-white text-3xl shadow-xl" style={`color:${track.bg}`}><Icon name={look.icon} /></span>
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-8 px-5 py-16 lg:grid-cols-[1.2fr_.8fr]">
    <div class="rounded-3xl bg-white p-8 shadow-sm ring-1 ring-ink/5">
      <p class="eyebrow">What you’ll learn</p>
      <h2 class="mt-3 font-serif text-3xl">By the end of your session</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {course.outcomes.map((item, index) => <li class="flex gap-4 rounded-2xl bg-sand p-4"><span class="grid h-9 w-9 shrink-0 place-items-center rounded-full font-semibold text-white" style={`background-color:${track.bg}`}>{index + 1}</span><span class="text-sm leading-6">{item}</span></li>)}
      </ul>
      <p class="mt-6 text-xs leading-5 text-gray-500">Each session is shaped around your goals, so we’ll focus on what matters most to you within the time you book.</p>
    </div>
    <aside class="grid content-start gap-6">
      <div class="rounded-3xl bg-night p-7 text-white"><Icon name="fa6-solid:user-group" class="text-2xl text-wheat" /><h2 class="mt-4 font-serif text-2xl">Who it’s for</h2><p class="mt-2 text-sm leading-7 text-white/85">{course.whoFor}</p></div>
      <div class="rounded-3xl bg-white p-7 shadow-sm ring-1 ring-ink/5"><h2 class="font-serif text-xl">Good to know</h2><ul class="mt-4 grid gap-2.5 text-sm leading-6">{BOOKING_GUIDELINES.map((line) => <li class="flex gap-3"><Icon name="fa6-solid:circle-check" class="mt-1 shrink-0 text-sage" />{line}</li>)}</ul><a class="mt-5 inline-flex text-sm font-semibold text-forest underline" href="/classes#group">Ask about group training</a></div>
    </aside>
  </section>

  <section id="book" class="scroll-mt-24 bg-cream py-16">
    <div class="mx-auto max-w-7xl px-5">
      <div class="max-w-2xl"><p class="eyebrow">Book {course.title.toLowerCase()}</p><h2 class="mt-3 font-serif text-4xl">Choose your time</h2><p class="mt-3 text-sm leading-7 text-gray-600">{formatMoneyWhole(course.hourlyRateCents)} per hour. You’ll pay with M-Pesa on the next page.</p></div>
      <div class="mt-10"><BookingForm courses={courses} selected={course} /></div>
    </div>
  </section>

  {others.length > 0 && (
    <section class="mx-auto max-w-7xl px-5 py-16">
      <div class="flex flex-wrap items-end justify-between gap-4"><div><p class="eyebrow">Keep learning</p><h2 class="mt-3 font-serif text-3xl">More virtual classes</h2></div><a href="/classes#courses" class="inline-flex items-center gap-2 text-sm font-semibold text-forest">All courses <Icon name="fa6-solid:arrow-right" class="text-xs" /></a></div>
      <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">{others.map((item) => <CourseCard course={item} />)}</div>
    </section>
  )}
</BaseLayout>
