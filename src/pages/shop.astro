---
import Pagination from '~/components/Pagination.astro';
import ProductCard from '~/components/ProductCard.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { activeCategories, filterOptions, parseShopFilters, searchShop, SHOP_SORTS } from '~/lib/catalogue';
import { breadcrumbJsonLd, siteOrigin } from '~/lib/seo';

const filters = parseShopFilters(Astro.url.searchParams);
const [categories, options, result] = await Promise.all([activeCategories(), filterOptions(), searchShop(filters)]);
const { products, total, page, pages } = result;
const filtered = Astro.url.search.replace(/[?&]?page=\d+/, '') !== '';
---
<BaseLayout title="Upholstery Fabrics by the Metre in Nairobi | Yucca Homeware" description="Shop upholstery fabrics by the metre in Nairobi: bouclé, linen, velvet, fur and leather. Pay with M-Pesa and get delivery across Kenya." structuredData={breadcrumbJsonLd(siteOrigin(Astro.url), [['Shop', '/shop']])}>
  <section class="bg-cream px-5 py-14 text-center"><p class="eyebrow">The Yucca collection</p><h1 class="mt-3 font-serif text-5xl">Fabrics to live with</h1><p class="mx-auto mt-4 max-w-xl text-sm leading-6 text-gray-600">Touchably beautiful textiles, chosen for real homes and the everyday moments inside them.</p></section>
  <section class="mx-auto max-w-7xl px-5 py-12">
    <form class="mb-9 grid gap-3 rounded-3xl bg-white p-5 shadow-sm ring-1 ring-ink/5 sm:grid-cols-2 lg:grid-cols-4" role="search" aria-label="Filter fabrics">
      <label class="relative text-sm">Search
        <input id="search" class="form-control mt-1" type="search" name="q" value={filters.q} placeholder="Fabric, colour, SKU…" autocomplete="off" aria-controls="search-suggestions" />
        <div id="search-suggestions" class="absolute left-0 right-0 top-full z-30 hidden overflow-hidden rounded-lg bg-white shadow-lg ring-1 ring-ink/10"></div>
      </label>
      <label class="text-sm">Category<select class="form-control mt-1" name="category"><option value="0">All categories</option>{categories.map((item) => <option value={item.id} selected={filters.category === item.id}>{item.name}</option>)}</select></label>
      <label class="text-sm">Colour<select class="form-control mt-1" name="colour"><option value="">All colours</option>{options.colours.map((option) => <option selected={filters.colour === option}>{option}</option>)}</select></label>
      <label class="text-sm">Material<select class="form-control mt-1" name="material"><option value="">All materials</option>{options.materials.map((option) => <option selected={filters.material === option}>{option}</option>)}</select></label>
      <label class="text-sm">Availability<select class="form-control mt-1" name="availability"><option value="">Any</option><option value="in_stock" selected={filters.availability === 'in_stock'}>In stock</option><option value="out_of_stock" selected={filters.availability === 'out_of_stock'}>Out of stock</option></select></label>
      <label class="text-sm">Sort<select class="form-control mt-1" name="sort">{Object.entries(SHOP_SORTS).map(([value, label]) => <option value={value} selected={filters.sort === value}>{label}</option>)}</select></label>
      <label class="text-sm">Minimum rating<select class="form-control mt-1" name="rating"><option value="0">Any rating</option>{[5, 4, 3, 2, 1].map((star) => <option value={star} selected={filters.rating === star}>{star}+ stars</option>)}</select></label>
      <div class="flex items-end gap-3"><button class="flex-1 rounded-full bg-forest px-6 py-3 text-sm font-semibold text-white transition hover:bg-olive">Find fabrics</button>{filtered && <a class="py-3 text-sm underline" href="/shop">Clear</a>}</div>
    </form>
    <p class="mb-5 text-xs text-gray-500" role="status">{total} {total === 1 ? 'piece' : 'pieces'} in the collection</p>
    {products.length > 0 ? (
      <div class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">{products.map((product) => <ProductCard product={product} />)}</div>
    ) : (
      <div class="rounded-3xl bg-white px-6 py-16 text-center shadow-sm ring-1 ring-ink/5"><h2 class="font-serif text-2xl">Nothing in the collection just yet</h2><p class="mt-3 text-sm text-gray-600">Try another search or get in touch and we’ll help you find it.</p><a class="mt-5 inline-block underline" href="/shop">Clear filters</a></div>
    )}
    <Pagination page={page} pages={pages} />
  </section>
</BaseLayout>

<script>
  import { notify } from '~/scripts/ui';

  // Live suggestions while typing; the form still works as a normal search without JS.
  const search = document.getElementById('search') as HTMLInputElement | null;
  const suggestions = document.getElementById('search-suggestions');
  if (search && suggestions) {
    let timer: ReturnType<typeof setTimeout>;
    const hide = () => { suggestions.replaceChildren(); suggestions.classList.add('hidden'); };
    search.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(async () => {
        const query = search.value.trim();
        if (query.length < 2) { hide(); return; }
        try {
          const response = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
          if (!response.ok) throw new Error(`Search failed (${response.status})`);
          const { results } = await response.json() as { results: { name: string; slug: string; colour: string | null }[] };
          suggestions.replaceChildren(...results.map((item) => {
            const link = document.createElement('a');
            link.className = 'block border-b border-ink/5 px-4 py-3 text-sm hover:bg-sand';
            link.href = `/products/${encodeURIComponent(item.slug)}`;
            link.textContent = item.colour ? `${item.name} · ${item.colour}` : item.name;
            return link;
          }));
          suggestions.classList.toggle('hidden', results.length === 0);
        } catch {
          hide();
          notify('Live search is temporarily unavailable.', true);
        }
      }, 180);
    });
    document.addEventListener('click', (event) => { if (!search.contains(event.target as Node) && !suggestions.contains(event.target as Node)) hide(); });
    search.addEventListener('keydown', (event) => { if (event.key === 'Escape') hide(); });
  }
</script>
