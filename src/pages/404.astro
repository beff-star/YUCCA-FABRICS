---
import Icon from '~/components/Icon.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Yucca Homeware" noindex>
  <section class="mx-auto max-w-2xl px-5 py-24 text-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-3 font-serif text-4xl sm:text-5xl">We couldn’t find that page</h1>
    <p class="mt-5 leading-7 text-gray-600">It may have moved, or the link may be mistyped. Try the fabric shop, or head back home.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/shop" class="btn-primary">Browse fabrics <Icon name="fa6-solid:arrow-right" class="text-xs" /></a>
      <a href="/" class="btn-secondary">Back home</a>
    </div>
  </section>
</BaseLayout>
