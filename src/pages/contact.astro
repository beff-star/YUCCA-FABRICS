---
import { actions } from 'astro:actions';
import { asc, eq } from 'drizzle-orm';
import FormResult from '~/components/FormResult.astro';
import Icon from '~/components/Icon.astro';
import YuccaSprig from '~/components/YuccaSprig.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { db, schema } from '~/lib/db';
import { businessJsonLd, metaDescription, siteOrigin } from '~/lib/seo';
import { DEFAULT_ADDRESS, DEFAULT_EMAIL, DEFAULT_PHONE, getSettings, setting, telHref, whatsappUrl } from '~/lib/settings';

const [faqs, settings] = await Promise.all([
  db.select().from(schema.faqs).where(eq(schema.faqs.isActive, true)).orderBy(asc(schema.faqs.sortOrder)).limit(8),
  getSettings(Astro.locals),
]);
const phone = setting(settings, 'business_phone', DEFAULT_PHONE);
const email = setting(settings, 'business_email', DEFAULT_EMAIL);
const address = setting(settings, 'business_address', DEFAULT_ADDRESS);
// Google Maps URLs (documented, no API key): opens directions to the saved address without embedding a tracker.
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
const channels = [
  ['fa6-solid:phone', '#1F5B43', 'text-white', 'Call us', phone, telHref(phone), false],
  ['fa6-brands:whatsapp', '#16646E', 'text-white', 'WhatsApp', 'Chat with us', whatsappUrl(settings), true],
  ['fa6-regular:envelope', '#A9461E', 'text-white', 'Email', email, `mailto:${email}`, false],
  ['fa6-solid:location-dot', '#E3A82B', 'text-ink', 'Visit', address, mapsUrl, true],
] as const;
// ?topic= pre-fills the subject, e.g. from the group training link on /classes.
const subject = (Astro.url.searchParams.get('topic') ?? '').slice(0, 180);
---
<BaseLayout title="Contact Us | Fabric Shop & Upholstery in Nairobi | Yucca Homeware" description={metaDescription(`Call, WhatsApp, email or visit Yucca Homeware in ${address} for upholstery fabrics, reupholstery, interior design and virtual classes.`)} structuredData={businessJsonLd(settings, siteOrigin(Astro.url))}>
  <section class="relative overflow-hidden bg-cream px-5 pb-24 pt-16 text-center">
    <YuccaSprig class="pointer-events-none absolute -left-16 -top-10 hidden h-72 w-72 text-olive/10 sm:block" />
    <div class="relative"><p class="eyebrow">We’re happy to help</p><h1 class="mt-3 font-serif text-4xl sm:text-5xl">Let’s have a conversation</h1><p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-gray-600">A fabric question, a project idea or a quick hello. Reach us whichever way suits you, and we’ll get back to you as soon as we can.</p></div>
  </section>
  <section class="relative mx-auto -mt-16 max-w-7xl px-5">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {channels.map(([icon, colour, iconText, label, value, href, external]) => (
        <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} class="group flex items-center gap-4 rounded-3xl bg-white p-5 shadow-lg shadow-ink/5 ring-1 ring-ink/5 transition motion-safe:hover:-translate-y-1"><span class:list={['grid h-12 w-12 shrink-0 place-items-center rounded-2xl text-lg', iconText]} style={`background-color:${colour}`}><Icon name={icon} /></span><span class="min-w-0"><span class="block text-xs font-semibold uppercase tracking-[.16em] text-gray-500">{label}</span><span class="block truncate font-semibold group-hover:text-forest">{value}</span></span></a>
      ))}
    </div>
  </section>
  <section class="mx-auto grid max-w-7xl gap-8 px-5 py-16 lg:grid-cols-[1.35fr_.65fr]">
    <div class="rounded-3xl bg-white p-7 shadow-sm ring-1 ring-ink/5 sm:p-10">
      <p class="eyebrow">Send a message</p><h2 class="mt-2 font-serif text-3xl">How can we help?</h2><p class="mt-2 text-sm text-gray-600">Tell us a little about what you need and we’ll reply by email or phone.</p>
      <form data-ajax-form="contact" action={actions.contact} method="post" class="mt-8 grid gap-4 sm:grid-cols-2">
        <FormResult action={actions.contact} class="sm:col-span-2" />
        <label class="text-sm font-medium">Your name<input class="form-control mt-1" name="name" required maxlength="150" autocomplete="name" /></label>
        <label class="text-sm font-medium">Email<input class="form-control mt-1" type="email" name="email" required autocomplete="email" /></label>
        <label class="text-sm font-medium">Phone (optional)<input class="form-control mt-1" type="tel" name="phone" autocomplete="tel" /></label>
        <label class="text-sm font-medium">Subject<input class="form-control mt-1" name="subject" required maxlength="180" value={subject} placeholder="e.g. Fabric for a corner sofa" /></label>
        <label class="text-sm font-medium sm:col-span-2">Message<textarea class="form-control mt-1" name="message" rows="6" minlength="10" maxlength="5000" required></textarea></label>
        <div class="hidden" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <button class="btn-primary w-fit shadow-md sm:col-span-2">Send your message <Icon name="fa6-solid:paper-plane" class="text-xs" /></button>
      </form>
    </div>
    <aside class="grid content-start gap-6">
      <div class="relative overflow-hidden rounded-3xl bg-forest p-7 text-white">
        <YuccaSprig class="pointer-events-none absolute -bottom-8 -right-8 h-40 w-40 text-white/10" />
        <Icon name="fa6-solid:location-dot" class="text-2xl text-wheat" />
        <h2 class="mt-4 font-serif text-2xl">Find us</h2>
        <p class="mt-2 text-sm leading-6 text-white/90">{address}</p>
        <a href={mapsUrl} target="_blank" rel="noopener" class="relative mt-6 inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-forest">Get directions <Icon name="fa6-solid:arrow-up-right-from-square" class="text-xs" /><span class="sr-only"> (opens Google Maps)</span></a>
      </div>
      <div class="rounded-3xl bg-white p-7 shadow-sm ring-1 ring-ink/5"><Icon name="fa6-regular:clock" class="text-2xl text-sage" /><h2 class="mt-4 font-serif text-2xl">Opening hours</h2><p class="mt-2 text-sm leading-6 text-gray-600">{setting(settings, 'business_hours', 'Monday–Saturday, 9 AM–5 PM')}</p><p class="mt-4 text-xs leading-5 text-gray-500">Planning a visit for a consultation? <a class="font-semibold text-forest underline" href="/consultations#book">Book a slot</a> so we can prepare samples for you.</p></div>
    </aside>
  </section>
  {faqs.length > 0 && (
    <section class="bg-cream py-16">
      <div class="mx-auto max-w-3xl px-5"><p class="eyebrow text-center">Good to know</p><h2 class="mt-2 text-center font-serif text-3xl">A few helpful answers</h2>
        <div class="mt-8 grid gap-3">{faqs.map((faq) => <details class="group rounded-2xl bg-white p-5 shadow-sm ring-1 ring-ink/5"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">{faq.question}<Icon name="fa6-solid:plus" class="shrink-0 text-sm text-sage transition group-open:rotate-45" /></summary><p class="mt-3 text-sm leading-7 text-gray-600">{faq.answer}</p></details>)}</div>
      </div>
    </section>
  )}
</BaseLayout>
