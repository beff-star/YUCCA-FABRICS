---
import Icon from '~/components/Icon.astro';
import AdminLayout from '~/layouts/AdminLayout.astro';
import { done } from '~/lib/admin-form';
import { formatDateTime, randomHex } from '~/lib/format';
import { disconnectGoogle, googleAuthUrl, googleConfigured, googleConnection, googleRedirectUri } from '~/lib/google';

const configured = googleConfigured();
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('intent') === 'connect' && configured) {
    // One-time state value, checked in /api/google/oauth-callback to stop forged callbacks.
    const state = randomHex(16);
    Astro.cookies.set('yf_google_state', state, { path: '/api/google', httpOnly: true, sameSite: 'lax', secure: true, maxAge: 600 });
    return Astro.redirect(googleAuthUrl(state), 303);
  }
  if (form.get('intent') === 'disconnect') {
    await disconnectGoogle();
    return done(Astro, 'success', 'Google disconnected. New classes will need meeting links added by hand.');
  }
}
const connection = configured ? await googleConnection() : { connected: false, since: null };
---
<AdminLayout title="Google Meet" heading="Google Meet & Calendar" intro="When connected, paid Google Meet classes automatically get a calendar event with a Meet link, and Google emails the invitation to the customer.">
  <a href="/admin/settings" class="mb-5 inline-flex items-center gap-2 text-sm font-semibold text-forest"><Icon name="fa6-solid:arrow-left" class="text-xs" />Settings</a>
  <section class="max-w-3xl rounded-3xl bg-white p-6 shadow-sm ring-1 ring-ink/5 sm:p-8">
    {!configured ? (
      <>
        <h2 class="font-serif text-2xl">Not set up yet</h2>
        <p class="mt-3 text-sm leading-6 text-gray-600">A developer needs to create a Google Cloud OAuth client once and add its secrets to the Worker:</p>
        <ol class="mt-4 grid list-decimal gap-2 pl-5 text-sm leading-6 text-gray-700">
          <li>In Google Cloud Console, enable the <strong>Google Calendar API</strong> and create an <strong>OAuth client ID</strong> (type: Web application).</li>
          <li>Add this authorised redirect URI: <code class="rounded bg-sand px-2 py-0.5 text-xs">{googleRedirectUri()}</code></li>
          <li>Set the secrets <code>GOOGLE_CLIENT_ID</code>, <code>GOOGLE_CLIENT_SECRET</code> and <code>TOKEN_ENCRYPTION_KEY</code> with <code>wrangler secret put</code>.</li>
          <li>Publish the OAuth app (consent screen) so the connection doesn’t expire after 7 days, then come back here and connect.</li>
        </ol>
      </>
    ) : connection.connected ? (
      <>
        <p class="flex items-center gap-3 text-lg font-semibold text-[#17442F]"><Icon name="fa6-solid:circle-check" />Connected</p>
        <p class="mt-2 text-sm text-gray-600">Connected {connection.since && formatDateTime(connection.since)}. Events are created in the connected account’s main calendar.</p>
        <form method="post" class="mt-6" data-confirm="Disconnect Google? New Meet classes will need links added by hand."><input type="hidden" name="intent" value="disconnect" /><button class="btn-secondary">Disconnect</button></form>
      </>
    ) : (
      <>
        <h2 class="font-serif text-2xl">Connect the business Google account</h2>
        <p class="mt-3 text-sm leading-6 text-gray-600">Sign in with the Google account whose calendar should hold class bookings. The site only asks to manage calendar events.</p>
        <form method="post" class="mt-6"><input type="hidden" name="intent" value="connect" /><button class="btn-primary"><Icon name="fa6-brands:google" />Connect Google account</button></form>
      </>
    )}
  </section>
</AdminLayout>
