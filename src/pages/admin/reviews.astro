---
import { desc, eq } from 'drizzle-orm';
import StatusBadge from '~/components/StatusBadge.astro';
import AdminLayout from '~/layouts/AdminLayout.astro';
import { done, int, text } from '~/lib/admin-form';
import { db, schema } from '~/lib/db';
import { formatDate } from '~/lib/format';

const r = schema.productReviews;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = int(form, 'id');
  const intent = text(form, 'intent', 10);
  if (!id) return done(Astro, 'error', 'Review not found.');
  if (intent === 'delete') await db.delete(r).where(eq(r.id, id));
  else if (intent === 'approved' || intent === 'rejected') await db.update(r).set({ status: intent }).where(eq(r.id, id));
  return done(Astro, 'success', intent === 'delete' ? 'Review deleted.' : `Review ${intent}.`);
}
const reviews = await db.select({ review: r, product: schema.products.name, slug: schema.products.slug, author: schema.user.name })
  .from(r).innerJoin(schema.products, eq(schema.products.id, r.productId)).innerJoin(schema.user, eq(schema.user.id, r.userId))
  .orderBy(desc(r.createdAt)).limit(200);
---
<AdminLayout title="Reviews" heading="Product reviews" intro="Reviews come only from customers with a delivered order. Approved reviews appear on the product page.">
  <div class="grid gap-4">
    {reviews.length === 0 && <p class="rounded-3xl bg-white p-6 text-sm text-gray-600">No reviews yet.</p>}
    {reviews.map(({ review, product, slug, author }) => (
      <article class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-ink/5">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div><p class="text-clay" aria-label={`${review.rating} out of 5`}>{'★'.repeat(review.rating)}<span class="text-gray-300">{'★'.repeat(5 - review.rating)}</span></p><h2 class="mt-1 font-semibold">{review.title || 'Untitled review'}</h2><p class="text-xs text-gray-500">{author} on <a class="underline" href={`/products/${slug}`}>{product}</a> · {formatDate(review.createdAt)}</p></div>
          <StatusBadge status={review.status} />
        </div>
        <p class="mt-3 text-sm leading-6 text-gray-700">{review.review}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {review.status !== 'approved' && <form method="post"><input type="hidden" name="id" value={review.id} /><input type="hidden" name="intent" value="approved" /><button class="btn-primary py-2">Approve</button></form>}
          {review.status !== 'rejected' && <form method="post"><input type="hidden" name="id" value={review.id} /><input type="hidden" name="intent" value="rejected" /><button class="btn-secondary py-2">Reject</button></form>}
          <form method="post" data-confirm="Delete this review permanently?"><input type="hidden" name="id" value={review.id} /><input type="hidden" name="intent" value="delete" /><button class="px-3 py-2 text-sm text-[#7A2E22] underline">Delete</button></form>
        </div>
      </article>
    ))}
  </div>
</AdminLayout>
