---
import { actions } from 'astro:actions';
import { eq, min, count, sql } from 'drizzle-orm';
import FormResult from '~/components/FormResult.astro';
import Icon from '~/components/Icon.astro';
import ServiceCard from '~/components/ServiceCard.astro';
import YuccaSprig from '~/components/YuccaSprig.astro';
import { fabricCollection, fabricImage } from '~/data/fabric-collection';
import { serviceImage } from '~/data/service-details';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { db, schema } from '~/lib/db';
import { todayInNairobi } from '~/lib/format';
import { formatMoneyWhole } from '~/lib/money';
import { breadcrumbJsonLd, businessId, businessJsonLd, metaDescription, siteOrigin } from '~/lib/seo';
import { activeServices, isConsultationService } from '~/lib/services';
import { DEFAULT_ADDRESS, DEFAULT_PHONE, getSettings, setting, telHref, whatsappUrl } from '~/lib/settings';

const [services, [fabrics]] = await Promise.all([
  activeServices(),
  db.select({ n: count(), from: min(sql<number>`coalesce(${schema.products.salePriceCents}, ${schema.products.priceCents})`) })
    .from(schema.products).where(eq(schema.products.isActive, true)),
]);
const requestServices = services.filter((service) => !isConsultationService(service));
const consultationPrices = services.filter(isConsultationService).map((s) => s.startingPriceCents).filter((p): p is number => p !== null);
const settings = await getSettings(Astro.locals);
const origin = siteOrigin(Astro.url);
const structuredData = [
  businessJsonLd(settings, origin),
  ...services.map((service) => ({
    '@context': 'https://schema.org', '@type': 'Service', name: service.name, description: metaDescription(service.description),
    serviceType: service.categoryName ?? undefined, provider: { '@id': businessId(origin) },
    areaServed: [{ '@type': 'City', name: 'Nairobi' }, { '@type': 'Country', name: 'Kenya' }],
    offers: service.startingPriceCents === null ? undefined : {
      '@type': 'Offer', priceCurrency: 'KES',
      priceSpecification: { '@type': 'PriceSpecification', minPrice: (service.startingPriceCents / 100).toFixed(0), priceCurrency: 'KES' },
    },
  })),
  breadcrumbJsonLd(origin, [['Services', '/services']]),
];
const steps = [
  ['fa6-solid:camera', '#1F5B43', 'text-white', 'Share your piece', `Send a photo and a few details with the form below, or visit us in ${setting(settings, 'business_address', DEFAULT_ADDRESS)}.`],
  ['fa6-solid:swatchbook', '#E3A82B', 'text-ink', 'Choose your fabric', 'Browse the collection online or compare samples with us until one feels right.'],
  ['fa6-solid:handshake', '#16646E', 'text-white', 'Agree the quote', 'We confirm the work, the price and the timing with you before anything begins.'],
  ['fa6-solid:couch', '#A9461E', 'text-white', 'Enjoy it again', 'Your piece is finished with care and ready to take its place at home.'],
];
const fileInput = 'form-control mt-1 text-sm file:mr-3 file:rounded-full file:border-0 file:bg-cream file:px-4 file:py-1.5 file:text-sm file:font-semibold file:text-forest';
---
<BaseLayout title="Upholstery & Interior Design Services in Nairobi | Yucca Homeware" description="Furniture reupholstery, sofa and cushion renewal, fabric and colour consultations and room styling from Yucca Homeware in Nairobi, Kenya." structuredData={structuredData}>
  <section class="relative overflow-hidden bg-cream">
    <YuccaSprig class="pointer-events-none absolute -left-20 -top-12 hidden h-80 w-80 text-olive/10 sm:block" />
    <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-5 py-16 lg:grid-cols-2 lg:py-24">
      <div>
        <p class="eyebrow">Upholstery &amp; interior services</p>
        <h1 class="mt-4 font-serif text-4xl leading-[1.08] sm:text-5xl lg:text-6xl">Good things,<br /><span class="text-clay">made useful again.</span></h1>
        <p class="mt-6 max-w-xl text-base leading-8 text-gray-600">From one tired cushion to a full room refresh, we pair skilled upholstery with fabrics chosen for real life. Bring us the piece you love, and we’ll help it feel new again.</p>
        <div class="mt-8 flex flex-wrap gap-3"><a href="#request-form" class="rounded-full bg-forest px-6 py-3 text-sm font-semibold text-white shadow-md transition hover:bg-olive">Start a project</a><a href="#services" class="rounded-full border border-forest/30 bg-white/60 px-6 py-3 text-sm font-semibold text-forest transition hover:bg-white">Explore services</a></div>
        <ul class="mt-10 flex flex-wrap gap-3 text-xs font-medium text-ink">
          <li class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-sm"><Icon name="fa6-solid:couch" class="text-pine" />Reupholstery &amp; cushion renewal</li>
          {fabrics?.from != null && <li class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-sm"><Icon name="fa6-solid:swatchbook" class="text-terracotta" />{fabrics.n} fabrics from {formatMoneyWhole(Number(fabrics.from))}/m</li>}
          {consultationPrices.length > 0 && <li class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-sm"><Icon name="fa6-solid:compass-drafting" class="text-teal" />Consultations from {formatMoneyWhole(Math.min(...consultationPrices))}</li>}
        </ul>
      </div>
      <div class="relative mx-auto w-full max-w-lg">
        <span class="absolute -right-5 -top-6 h-36 w-36 rounded-full bg-mustard" aria-hidden="true"></span>
        <span class="absolute -bottom-8 -left-6 h-44 w-44 rounded-full bg-teal" aria-hidden="true"></span>
        <div class="relative grid h-[420px] grid-cols-5 grid-rows-6 gap-3 sm:h-[520px]">
          <img src={serviceImage('reupholstery-tufted-corduroy.jpg')} alt="Green corduroy upholstery with tufted buttons" class="col-span-3 row-span-6 h-full w-full rounded-3xl object-cover shadow-xl" />
          <img src={serviceImage('cushion-renewal-mustard-cushion.jpg')} alt="Mustard cushion on an upholstered armchair" class="col-span-2 row-span-3 h-full w-full rounded-3xl object-cover shadow-xl" />
          <img src={serviceImage('green-sofa-cushions.jpg')} alt="Green sofa with patterned cushions" class="col-span-2 row-span-3 h-full w-full rounded-3xl object-cover shadow-xl" />
        </div>
        <div class="absolute -bottom-6 right-4 flex items-center gap-3 rounded-2xl bg-white px-5 py-4 shadow-xl sm:left-1/3 sm:right-auto"><span class="grid h-10 w-10 place-items-center rounded-full bg-terracotta text-white"><Icon name="fa6-solid:scissors" /></span><span class="text-xs leading-5 text-gray-600"><strong class="block text-sm text-ink">Made to measure</strong>for the pieces you love</span></div>
      </div>
    </div>
  </section>

  <section id="services" class="py-20">
    <div class="mx-auto max-w-7xl px-5">
      <div class="mx-auto max-w-2xl text-center"><p class="eyebrow">What we do</p><h2 class="mt-3 font-serif text-4xl sm:text-5xl">A considered hand with every detail</h2><p class="mt-4 text-sm leading-7 text-gray-600">Some projects start with a favourite chair. Others start with a room that doesn’t quite feel finished. Choose a service to get started, or simply tell us what you have in mind.</p></div>
      {services.length > 0 ? (
        <div class="mt-14 grid gap-8 md:grid-cols-2">{services.map((service) => <ServiceCard service={service} />)}</div>
      ) : (
        <p class="mt-10 text-center text-sm text-gray-600">Our services are being updated. <a class="underline" href="/contact">Contact us</a> and we’ll be glad to help.</p>
      )}
      <a href="/classes" class="mx-auto mt-12 flex max-w-3xl flex-col items-start gap-4 rounded-3xl bg-night p-7 text-white shadow-lg transition hover:-translate-y-0.5 sm:flex-row sm:items-center">
        <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-wheat text-xl text-night"><Icon name="fa6-solid:chalkboard-user" /></span>
        <span class="flex-1"><span class="block font-serif text-xl">Prefer to learn it yourself?</span><span class="mt-1 block text-sm leading-6 text-white/85">Book a live virtual class on furniture, upholstery or interior design, by the hour.</span></span>
        <span class="inline-flex items-center gap-2 text-sm font-semibold text-wheat">See the classes <Icon name="fa6-solid:arrow-right" class="text-xs" /></span>
      </a>
    </div>
  </section>

  <section class="relative overflow-hidden bg-night py-20 text-white">
    <YuccaSprig class="pointer-events-none absolute -bottom-16 -right-16 h-96 w-96 text-white/5" />
    <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-5 lg:grid-cols-[.9fr_1.1fr]">
      <img src={serviceImage('upholstery-workshop-chair.jpg')} alt="A curved upholstered chair in a workshop" loading="lazy" class="mx-auto aspect-[4/5] w-full max-w-md rounded-3xl object-cover shadow-2xl" />
      <div>
        <p class="eyebrow">How it works</p>
        <h2 class="mt-3 font-serif text-4xl sm:text-5xl">From first photo to finished piece</h2>
        <p class="mt-4 max-w-xl text-sm leading-7 text-cream/80">No guesswork and no surprises: you’ll know what we’re doing, what it costs and when it will be ready.</p>
        <ol class="mt-10 grid gap-5 sm:grid-cols-2">
          {steps.map(([icon, colour, iconText, title, text], index) => (
            <li class="rounded-2xl bg-white/5 p-6 ring-1 ring-white/10"><div class="flex items-center gap-4"><span class:list={['grid h-12 w-12 shrink-0 place-items-center rounded-2xl text-lg', iconText]} style={`background-color:${colour}`}><Icon name={icon!} /></span><span class="font-serif text-sm text-wheat">Step {index + 1}</span></div><h3 class="mt-4 text-lg font-semibold">{title}</h3><p class="mt-2 text-sm leading-6 text-cream/80">{text}</p></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="mx-auto max-w-7xl px-5">
      <div class="flex flex-wrap items-end justify-between gap-4"><div><p class="eyebrow">Start with the fabric</p><h2 class="mt-3 font-serif text-4xl">{fabricCollection.length} textures, one for every room</h2></div><a href="/shop" class="inline-flex items-center gap-2 text-sm font-semibold text-forest">Browse the collection <Icon name="fa6-solid:arrow-right" class="text-xs" /></a></div>
      <div class="mt-8 grid grid-cols-3 gap-3 sm:grid-cols-6 sm:gap-4">
        {fabricCollection.slice(6, 12).map((fabric) => <a href={`/shop?q=${encodeURIComponent(fabric.name)}`} class="group block"><span class="block overflow-hidden rounded-2xl"><img src={fabricImage(fabric.image)} alt={`${fabric.name} ${fabric.type}`} loading="lazy" class="aspect-square w-full object-cover object-top motion-safe:transition motion-safe:duration-500 motion-safe:group-hover:scale-110" /></span><span class="mt-2 block text-sm font-semibold">{fabric.name}</span><span class="block text-[10px] uppercase tracking-widest text-gray-500">{fabric.type}</span></a>)}
      </div>
    </div>
  </section>

  <section id="request-form" class="bg-cream py-20">
    <div class="mx-auto max-w-7xl px-5">
      <div class="overflow-hidden rounded-3xl bg-white shadow-xl shadow-ink/10 lg:grid lg:grid-cols-[.8fr_1.2fr]">
        <aside class="relative overflow-hidden bg-forest p-8 text-white sm:p-10">
          <YuccaSprig class="pointer-events-none absolute -bottom-10 -right-10 h-64 w-64 text-white/10" />
          <div class="relative">
            <p class="eyebrow">Tell us a little</p>
            <h2 class="mt-3 font-serif text-4xl">Start a project</h2>
            <p class="mt-4 text-sm leading-7 text-white/85">Share a few details and a photo if you have one. We’ll follow up to learn more and prepare the right advice and quote.</p>
            <ul class="mt-8 grid gap-4 text-sm">
              <li class="flex gap-3"><Icon name="fa6-solid:reply" class="mt-1 shrink-0 text-wheat" /><span>We reply to discuss your piece and next steps.</span></li>
              <li class="flex gap-3"><Icon name="fa6-solid:file-invoice" class="mt-1 shrink-0 text-wheat" /><span>You get a clear quote before any work starts.</span></li>
              <li class="flex gap-3"><Icon name="fa6-solid:camera" class="mt-1 shrink-0 text-wheat" /><span>A photo of the piece helps us advise you faster.</span></li>
            </ul>
            <div class="mt-10 flex flex-wrap gap-3 text-sm font-semibold"><a href={telHref(setting(settings, 'business_phone', DEFAULT_PHONE))} class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-forest"><Icon name="fa6-solid:phone" />Call us</a><a href={whatsappUrl(settings)} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-white/40 px-5 py-2.5"><Icon name="fa6-brands:whatsapp" />WhatsApp</a></div>
          </div>
        </aside>
        <form data-ajax-form="serviceRequest" action={actions.serviceRequest} enctype="multipart/form-data" method="post" class="grid gap-4 p-8 sm:grid-cols-2 sm:p-10">
          <FormResult action={actions.serviceRequest} class="sm:col-span-2" />
          <label class="text-sm font-medium sm:col-span-2">Service<select id="service-id" class="form-control mt-1" name="service_id"><option value="">Not sure yet, I’d like advice</option>{requestServices.map((service) => <option value={service.id}>{service.name}</option>)}</select></label>
          <label class="text-sm font-medium">Your name<input class="form-control mt-1" name="name" required maxlength="150" autocomplete="name" /></label>
          <label class="text-sm font-medium">Email<input class="form-control mt-1" type="email" name="email" required autocomplete="email" /></label>
          <label class="text-sm font-medium">Phone<input class="form-control mt-1" type="tel" name="phone" required autocomplete="tel" /></label>
          <label class="text-sm font-medium">Project location<input class="form-control mt-1" name="location" required maxlength="255" /></label>
          <label class="text-sm font-medium">Preferred date (optional)<input class="form-control mt-1" type="date" name="preferred_date" min={todayInNairobi()} /></label>
          <label class="text-sm font-medium">Reference photo (optional)<input class={fileInput} type="file" name="reference_image" accept="image/jpeg,image/png,image/webp" /></label>
          <label class="text-sm font-medium sm:col-span-2">What would you like help with?<textarea class="form-control mt-1" name="description" rows="5" minlength="10" maxlength="5000" required placeholder="For example: a three-seater sofa with sagging seats; we’d like a hard-wearing fabric in a warm colour."></textarea></label>
          <button class="btn-primary w-fit shadow-md sm:col-span-2">Send project request <Icon name="fa6-solid:paper-plane" class="text-xs" /></button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
