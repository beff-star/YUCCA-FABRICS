---
// Split sign-in layout; the photo panel is hidden on small screens.
import FormAlert from '~/components/FormAlert.astro';
import Icon from '~/components/Icon.astro';
import YuccaSprig from '~/components/YuccaSprig.astro';
import { fabricImage } from '~/data/fabric-collection';
import BaseLayout from './BaseLayout.astro';

interface Props { title: string; eyebrow: string; heading: string; intro?: string; errors?: string[]; success?: string }
const { title, eyebrow, heading, intro, errors = [], success } = Astro.props;
const benefits = ['Follow your orders from bag to doorstep', 'Join your virtual classes in one click', 'Save favourite fabrics to compare later', 'Manage consultations and upholstery requests'];
---
<BaseLayout title={`${title} | Yucca Homeware`} noindex>
  <section class="bg-cream px-5 py-10 sm:py-16">
    <div class="mx-auto grid max-w-6xl overflow-hidden rounded-3xl bg-white shadow-xl shadow-ink/10 lg:grid-cols-[1fr_1.05fr]">
      <div class="relative hidden min-h-[560px] lg:block">
        <img src={fabricImage('harmony-linen.jpeg')} alt="" class="absolute inset-0 h-full w-full object-cover object-top" />
        <span class="absolute inset-0 bg-gradient-to-t from-night via-night/70 to-night/10" aria-hidden="true"></span>
        <div class="absolute inset-x-0 bottom-0 p-10 text-white">
          <YuccaSprig class="h-12 w-12 text-wheat" />
          <p class="mt-4 font-serif text-3xl leading-tight">A softer place to land.</p>
          <ul class="mt-6 grid gap-3 text-sm text-white/90">{benefits.map((benefit) => <li class="flex gap-3"><Icon name="fa6-solid:circle-check" class="mt-1 shrink-0 text-wheat" />{benefit}</li>)}</ul>
        </div>
      </div>
      <div class="p-7 sm:p-12">
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="mt-3 font-serif text-3xl sm:text-4xl">{heading}</h1>
        {intro && <p class="mt-3 text-sm leading-6 text-gray-600">{intro}</p>}
        <div class="mt-8">
          {errors.map((error) => <FormAlert message={error} class="mb-3" />)}
          {success && <FormAlert message={success} type="success" class="mb-5" />}
          <slot />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
