---
import Icon from './Icon.astro';
import { courseLook, LEVEL_LABELS, tracks } from '~/data/courses';
import { serviceImage } from '~/data/service-details';
import { formatMoneyWhole } from '~/lib/money';
import type { Course } from '~/lib/training';

interface Props { course: Course; hidden?: boolean }
const { course, hidden = false } = Astro.props;
const track = tracks[course.track];
const look = courseLook(course.slug);
---
<article class="group flex flex-col overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-ink/5 transition motion-safe:hover:-translate-y-1 hover:shadow-xl" data-track={course.track} hidden={hidden}>
  <a href={`/classes/${course.slug}`} class="relative block aspect-[16/10] overflow-hidden" tabindex="-1" aria-hidden="true">
    <img src={serviceImage(look.image)} alt="" loading="lazy" class="h-full w-full object-cover motion-safe:transition motion-safe:duration-700 motion-safe:group-hover:scale-105" />
    <span class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-transparent"></span>
    <span class="absolute left-4 top-4 rounded-full px-3 py-1 text-[10px] font-semibold uppercase tracking-[.16em] text-white" style={`background-color:${track.bg}`}>{track.label}</span>
    <span class="absolute bottom-4 left-4 rounded-full bg-white/95 px-3 py-1 text-[11px] font-semibold text-ink">{LEVEL_LABELS[course.level]}</span>
  </a>
  <div class="relative flex flex-1 flex-col p-6">
    <span class="absolute -top-7 right-5 grid h-14 w-14 place-items-center rounded-2xl bg-white text-xl shadow-lg" style={`color:${track.bg}`}><Icon name={look.icon} /></span>
    <h3 class="pr-14 font-serif text-xl leading-snug"><a class="transition hover:text-forest" href={`/classes/${course.slug}`}>{course.title}</a></h3>
    <p class="mt-3 text-sm leading-6 text-gray-600">{course.summary}</p>
    <ul class="mt-4 grid gap-2 pb-6 text-sm">
      {course.outcomes.slice(0, 3).map((item) => <li class="flex gap-2.5"><Icon name="fa6-solid:circle-check" class="mt-1 shrink-0 text-sage" /><span>{item}</span></li>)}
    </ul>
    <div class="mt-auto flex flex-wrap items-end justify-between gap-3 border-t border-ink/10 pt-5">
      <p><span class="block font-serif text-2xl text-forest">{formatMoneyWhole(course.hourlyRateCents)}</span><span class="text-xs text-gray-500">per hour · live online</span></p>
      <div class="flex gap-2">
        <a href={`/classes/${course.slug}`} class="rounded-full border border-forest/30 px-4 py-2 text-xs font-semibold text-forest transition hover:bg-cream">Details<span class="sr-only"> about {course.title}</span></a>
        <a href={`/classes/${course.slug}#book`} class="rounded-full bg-forest px-4 py-2 text-xs font-semibold text-white transition hover:bg-olive">Book<span class="sr-only"> {course.title}</span></a>
      </div>
    </div>
  </div>
</article>
