---
import Icon from './Icon.astro';
import { formatDate, readMinutes } from '~/lib/format';
import { journalImage, type JournalPost } from '~/lib/journal';

interface Props { post: JournalPost }
const { post } = Astro.props;
const href = `/journal/${post.slug}`;
---
<article class="group flex flex-col overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-ink/5 transition motion-safe:hover:-translate-y-1 hover:shadow-xl">
  <a href={href} class="relative block aspect-[4/3] overflow-hidden" tabindex="-1" aria-hidden="true">
    <img class="h-full w-full object-cover motion-safe:transition motion-safe:duration-700 motion-safe:group-hover:scale-105" src={journalImage(post.image)} alt="" loading="lazy" />
    <span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1 text-[10px] font-semibold uppercase tracking-[.16em] text-ink">{post.categoryName ?? 'Yucca notes'}</span>
  </a>
  <div class="flex flex-1 flex-col p-6">
    <p class="text-xs text-gray-500">{post.publishedAt && formatDate(post.publishedAt)} · {readMinutes(post.body)} min read</p>
    <h3 class="mt-2 font-serif text-xl leading-snug"><a class="transition hover:text-forest" href={href}>{post.title}</a></h3>
    <p class="mt-3 line-clamp-2 text-sm leading-6 text-gray-600">{post.excerpt || post.body.replace(/^#+ /gm, '')}</p>
    <a class="mt-auto inline-flex items-center gap-2 pt-5 text-sm font-semibold text-forest" href={href}>Read the story <Icon name="fa6-solid:arrow-right" class="text-xs" /><span class="sr-only">: {post.title}</span></a>
  </div>
</article>
