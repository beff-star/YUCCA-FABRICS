---
import Icon from './Icon.astro';

interface Props { name: string; id: string; label: string; autocomplete: string; minlength?: number; hint?: string }
const { name, id, label, autocomplete, minlength, hint } = Astro.props;
---
<div>
  <label class="text-sm font-medium" for={id}>{label}</label>
  <div class="relative mt-1">
    <input id={id} class="form-control pr-12" type="password" name={name} required autocomplete={autocomplete} minlength={minlength} maxlength="128" aria-describedby={hint ? `${id}-hint` : undefined} />
    <button type="button" class="absolute inset-y-0 right-0 grid w-12 place-items-center text-gray-500 hover:text-forest" data-toggle-password aria-label="Show password" aria-pressed="false">
      <Icon name="fa6-regular:eye" data-eye="show" />
      <Icon name="fa6-regular:eye-slash" data-eye="hide" class="hidden" />
    </button>
  </div>
  {hint && <p id={`${id}-hint`} class="mt-1.5 text-xs text-gray-500">{hint}</p>}
</div>
