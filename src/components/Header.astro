---
import Icon from './Icon.astro';
import { cartCount } from '~/lib/cart';
import { DEFAULT_ADDRESS, DEFAULT_EMAIL, DEFAULT_PHONE, getSettings, setting, telHref } from '~/lib/settings';

// Navigation is defined once here and rendered for both desktop and mobile.
interface NavLink { href: string; label: string; match?: string[] }
interface NavGroup { label: string; children: NavLink[]; match: string[] }
const serviceLinks: NavLink[] = [
  { href: '/services', label: 'Upholstery services' },
  { href: '/consultations', label: 'Interior design consultations' },
  { href: '/classes', label: 'Virtual classes & training' },
  { href: '/gallery#fabric-lookbook', label: 'Fabric lookbook' },
];
const navLinks: (NavLink | NavGroup)[] = [
  { href: '/', label: 'Home' },
  { href: '/shop', label: 'Shop', match: ['/shop', '/products'] },
  { label: 'Services', children: serviceLinks, match: ['/services', '/consultations'] },
  { href: '/classes', label: 'Classes', match: ['/classes'] },
  { href: '/gallery', label: 'Gallery' },
  { href: '/journal', label: 'Journal', match: ['/journal'] },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname;
const isActive = (link: { href?: string; match?: string[] }) =>
  link.href === path || (link.match ?? []).some((prefix) => path === prefix || path.startsWith(`${prefix}/`));

const { user } = Astro.locals;
const isCustomer = user?.role === 'customer';
const accountUrl = user ? (user.role === 'admin' ? '/admin' : '/account') : '/auth/login';
const settings = await getSettings(Astro.locals);
const phone = setting(settings, 'business_phone', DEFAULT_PHONE);
const email = setting(settings, 'business_email', DEFAULT_EMAIL);
const bagCount = await cartCount(Astro);
---
<div class="bg-night text-[11px] tracking-wide text-cream/80">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-2">
    <p class="truncate"><Icon name="fa6-solid:location-dot" class="mr-1.5 inline text-wheat" />{setting(settings, 'business_address', DEFAULT_ADDRESS)}<span class="hidden sm:inline"> · Fabrics, upholstery &amp; interiors</span></p>
    <div class="flex shrink-0 items-center gap-4">
      <a class="hover:text-wheat" href={telHref(phone)}><Icon name="fa6-solid:phone" class="mr-1.5 inline text-wheat" />{phone}</a>
      <a class="hidden hover:text-wheat md:inline" href={`mailto:${email}`}><Icon name="fa6-regular:envelope" class="mr-1.5 inline text-wheat" />{email}</a>
    </div>
  </div>
</div>
<header id="site-header" class="site-header sticky top-0 z-40 border-b border-ink/10 bg-sand/95 backdrop-blur supports-[backdrop-filter]:bg-sand/85">
  <div class="mx-auto flex max-w-7xl items-center gap-4 px-5 py-3 lg:gap-6">
    <a href="/" aria-label="Yucca Homeware home" class="flex shrink-0 items-center gap-3">
      <img src="/images/yucca-homeware-logo.jpeg" alt="" width="56" height="56" class="site-logo h-14 w-14 object-contain mix-blend-multiply" />
      <span class="leading-none"><span class="block font-serif text-lg font-semibold tracking-[.18em] text-forest">YUCCA</span><span class="mt-1 block text-[10px] font-medium tracking-[.42em] text-clay">HOMEWARE</span></span>
    </a>
    <nav class="ml-auto hidden items-center gap-5 text-sm font-medium lg:flex xl:gap-6" aria-label="Main">
      {navLinks.map((link) => 'children' in link ? (
        <div class="dropdown relative" data-dropdown>
          <button type="button" class:list={['nav-link inline-flex items-center gap-1.5', { 'is-active': isActive(link) }]} aria-expanded="false" aria-controls="services-menu">{link.label} <Icon name="fa6-solid:chevron-down" class="chevron text-[10px]" /></button>
          <div id="services-menu" class="dropdown-panel absolute left-1/2 top-full z-50 w-64 -translate-x-1/2 pt-3">
            <div class="overflow-hidden rounded-lg border border-ink/10 bg-white py-2 shadow-xl shadow-ink/10">
              {link.children.map((child) => <a class="block px-4 py-2.5 text-sm text-ink transition hover:bg-cream hover:text-forest" href={child.href}>{child.label}</a>)}
            </div>
          </div>
        </div>
      ) : (
        <a class:list={['nav-link', { 'is-active': isActive(link) }, link.href === '/' && 'xl:inline hidden']} href={link.href} aria-current={isActive(link) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-1 lg:ml-0">
      <button type="button" class="icon-button" data-search-toggle aria-expanded="false" aria-controls="site-search" aria-label="Search fabrics"><Icon name="fa6-solid:magnifying-glass" /></button>
      {isCustomer && <a class="icon-button hidden sm:inline-flex" href="/account/wishlist" aria-label="Saved favourites"><Icon name="fa6-regular:heart" /></a>}
      {user ? (
        <div class="dropdown relative hidden sm:block" data-dropdown>
          <button type="button" class="icon-button" aria-expanded="false" aria-controls="account-menu" aria-label="Account menu"><Icon name="fa6-regular:user" /></button>
          <div id="account-menu" class="dropdown-panel dropdown-panel-end absolute right-0 top-full z-50 w-60 pt-3">
            <div class="overflow-hidden rounded-lg border border-ink/10 bg-white py-2 text-sm shadow-xl shadow-ink/10">
              <p class="truncate border-b border-ink/10 px-4 pb-3 pt-1 text-xs text-gray-500">Signed in as <strong class="text-ink">{user.name}</strong></p>
              <a class="mt-1 block px-4 py-2.5 transition hover:bg-cream hover:text-forest" href={accountUrl}>{user.role === 'admin' ? 'Admin dashboard' : 'My account'}</a>
              {isCustomer && (
                <>
                  <a class="block px-4 py-2.5 transition hover:bg-cream hover:text-forest" href="/account/orders">My orders</a>
                  <a class="block px-4 py-2.5 transition hover:bg-cream hover:text-forest" href="/account/classes">My classes</a>
                  <a class="block px-4 py-2.5 transition hover:bg-cream hover:text-forest" href="/account/wishlist">Saved favourites</a>
                </>
              )}
              <form action="/auth/logout" method="post" class="mt-1 border-t border-ink/10 pt-1"><button class="block w-full px-4 py-2.5 text-left transition hover:bg-cream hover:text-clay">Sign out</button></form>
            </div>
          </div>
        </div>
      ) : (
        <a class="icon-button hidden sm:inline-flex" href={accountUrl} aria-label="Sign in"><Icon name="fa6-regular:user" /></a>
      )}
      <a class="icon-button relative" href="/cart" aria-label={`Shopping bag, ${bagCount} ${bagCount === 1 ? 'item' : 'items'}`}><Icon name="fa6-solid:bag-shopping" /><span id="cart-count" aria-hidden="true" class="absolute -right-0.5 -top-0.5 grid h-5 min-w-5 place-items-center rounded-full bg-clay px-1 text-[10px] font-semibold text-white">{bagCount}</span></a>
      <a href="/consultations" class="ml-3 hidden rounded-full bg-forest px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-olive xl:inline-block">Book a consultation</a>
      <button id="menu-toggle" type="button" class="icon-button lg:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <Icon name="fa6-solid:bars" data-menu-icon="closed" />
        <Icon name="fa6-solid:xmark" data-menu-icon="open" class="hidden" />
      </button>
    </div>
  </div>
  <div id="site-search" class="hidden border-t border-ink/10 bg-sand">
    <form action="/shop" method="get" role="search" class="mx-auto flex max-w-3xl items-center gap-3 px-5 py-4">
      <label class="sr-only" for="site-search-input">Search fabrics</label>
      <input id="site-search-input" name="q" type="search" placeholder="Search fabrics by name, colour or code…" class="form-control" autocomplete="off" />
      <button class="shrink-0 rounded-full bg-forest px-5 py-3 text-sm font-semibold text-white transition hover:bg-olive">Search</button>
    </form>
  </div>
  <div id="mobile-nav" class="hidden max-h-[calc(100dvh-5rem)] overflow-y-auto border-t border-ink/10 bg-sand lg:hidden">
    <nav class="mx-auto grid max-w-7xl gap-1 px-5 py-4 text-base" aria-label="Mobile">
      {navLinks.map((link) => 'children' in link ? (
        <>
          <p class="px-3 pb-1 pt-3 text-[11px] font-semibold uppercase tracking-[.2em] text-sage">{link.label}</p>
          {link.children.map((child) => <a class:list={['mobile-link pl-6', { 'is-active': child.href === path }]} href={child.href}>{child.label}</a>)}
        </>
      ) : (
        <a class:list={['mobile-link', { 'is-active': isActive(link) }]} href={link.href} aria-current={isActive(link) ? 'page' : undefined}>{link.label}</a>
      ))}
      <div class="mt-3 grid gap-1 border-t border-ink/10 pt-3">
        <a class="mobile-link" href={accountUrl}><Icon name="fa6-regular:user" class="mr-3 inline w-4 text-sage" />{user ? (user.role === 'admin' ? 'Admin dashboard' : 'My account') : 'Sign in / Register'}</a>
        {isCustomer && <a class="mobile-link" href="/account/wishlist"><Icon name="fa6-regular:heart" class="mr-3 inline w-4 text-sage" />Saved favourites</a>}
        {user && <form action="/auth/logout" method="post"><button class="mobile-link w-full text-left"><Icon name="fa6-solid:arrow-right-from-bracket" class="mr-3 inline w-4 text-sage" />Sign out</button></form>}
      </div>
      <a href="/consultations" class="mt-4 rounded-full bg-forest px-5 py-3.5 text-center text-sm font-semibold text-white">Book a consultation</a>
    </nav>
  </div>
</header>
