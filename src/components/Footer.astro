---
import { actions } from 'astro:actions';
import Icon from './Icon.astro';
import { DEFAULT_ADDRESS, DEFAULT_EMAIL, DEFAULT_PHONE, getSettings, setting, socialLinks, telHref } from '~/lib/settings';

const settings = await getSettings(Astro.locals);
const phone = setting(settings, 'business_phone', DEFAULT_PHONE);
const email = setting(settings, 'business_email', DEFAULT_EMAIL);
const hours = setting(settings, 'business_hours');
const promises = [
  ['fa6-solid:swatchbook', 'A curated fabric collection', 'Bouclé, linen, velvet and more, chosen to be lived with.'],
  ['fa6-solid:couch', 'Skilled upholstery', 'Reupholstery and cushion renewal for much-loved pieces.'],
  ['fa6-solid:mobile-screen-button', 'Pay your way', 'M-Pesa, bank transfer or cash on delivery.'],
  ['fa6-solid:truck-fast', 'Delivered to your door', 'Fabric and finished pieces brought to you.'],
];
// Shows the newsletter result when the form was submitted without JavaScript.
const newsletterResult = Astro.getActionResult(actions.newsletter);
const newsletterMessage = newsletterResult?.error ? 'Enter a valid email address.' : newsletterResult?.data?.message;
---
<footer class="bg-night text-cream/75">
  <div class="border-b border-white/10">
    <ul class="mx-auto grid max-w-7xl grid-cols-1 gap-6 px-5 py-10 sm:grid-cols-2 lg:grid-cols-4">
      {promises.map(([icon, title, text]) => (
        <li class="flex gap-4"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-white/5 text-wheat ring-1 ring-white/10"><Icon name={icon!} /></span><span><span class="block text-sm font-semibold text-white">{title}</span><span class="mt-1 block text-xs leading-5 text-cream/60">{text}</span></span></li>
      ))}
    </ul>
  </div>
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-5 py-14 sm:grid-cols-2 lg:grid-cols-12">
    <div class="sm:col-span-2 lg:col-span-5 lg:pr-10">
      <a href="/" aria-label="Yucca Homeware home" class="inline-flex items-center gap-3"><img src="/images/yucca-homeware-logo.jpeg" alt="" width="64" height="64" loading="lazy" class="h-16 w-16 rounded-xl bg-white object-contain p-1" /><span class="leading-none"><span class="block font-serif text-xl font-semibold tracking-[.18em] text-white">YUCCA</span><span class="mt-1 block text-[10px] tracking-[.42em] text-wheat">FABRICS</span></span></a>
      <p class="mt-5 max-w-sm text-sm leading-7">A softer place to land. Fabric, furnishing and thoughtful interiors crafted around the way you live.</p>
      <form data-ajax-form="newsletter" action={actions.newsletter} method="post" class="mt-6 max-w-sm">
        <label class="text-xs font-semibold uppercase tracking-[.2em] text-wheat" for="newsletter-email">Notes from the studio</label>
        <p class="mt-2 text-xs text-cream/60">New fabrics, room ideas, class dates and the occasional offer. No spam.</p>
        <div class="mt-3 flex overflow-hidden rounded-full bg-white/5 ring-1 ring-white/15 focus-within:ring-wheat"><input id="newsletter-email" name="email" type="email" required placeholder="Your email address" autocomplete="email" class="min-w-0 flex-1 bg-transparent px-5 py-3 text-sm text-white placeholder:text-cream/40 focus:outline-none" /><button class="m-1 rounded-full bg-wheat px-5 text-sm font-semibold text-night transition hover:bg-white">Subscribe</button></div>
        {newsletterMessage && <p class="mt-3 text-sm text-wheat" role="status">{newsletterMessage}</p>}
      </form>
      <div class="mt-6 flex gap-2">
        {socialLinks(settings).map((social) => <a class="social-link" href={social.url} target="_blank" rel="noopener" aria-label={`Yucca Homeware on ${social.label} (opens in a new tab)`} title={social.label}><Icon name={social.icon} /></a>)}
      </div>
    </div>
    <div class="lg:col-span-2"><h2 class="footer-heading">Shop</h2><ul class="footer-list"><li><a href="/shop">All fabrics</a></li><li><a href="/shop?sort=newest">New arrivals</a></li><li><a href="/gallery#fabric-lookbook">Fabric lookbook</a></li><li><a href="/cart">Shopping bag</a></li><li><a href={Astro.locals.user ? '/account/orders' : '/auth/login'}>Track an order</a></li></ul></div>
    <div class="lg:col-span-2"><h2 class="footer-heading">Studio</h2><ul class="footer-list"><li><a href="/services">Upholstery services</a></li><li><a href="/consultations">Interior design</a></li><li><a href="/classes">Virtual classes</a></li><li><a href="/gallery">Our projects</a></li><li><a href="/journal">Journal</a></li><li><a href="/about">About us</a></li></ul></div>
    <div class="sm:col-span-2 lg:col-span-3"><h2 class="footer-heading">Visit or call</h2>
      <ul class="footer-list">
        <li class="flex gap-3"><Icon name="fa6-solid:location-dot" class="mt-1 w-4 shrink-0 text-wheat" /><span>{setting(settings, 'business_address', DEFAULT_ADDRESS)}</span></li>
        <li class="flex gap-3"><Icon name="fa6-solid:phone" class="mt-1 w-4 shrink-0 text-wheat" /><a href={telHref(phone)}>{phone}</a></li>
        <li class="flex gap-3"><Icon name="fa6-regular:envelope" class="mt-1 w-4 shrink-0 text-wheat" /><a class="break-all" href={`mailto:${email}`}>{email}</a></li>
        {hours && <li class="flex gap-3"><Icon name="fa6-regular:clock" class="mt-1 w-4 shrink-0 text-wheat" /><span>{hours}</span></li>}
      </ul>
      <a href="/contact" class="mt-6 inline-flex items-center gap-2 rounded-full border border-wheat/60 px-5 py-2.5 text-sm font-semibold text-wheat transition hover:bg-wheat hover:text-night">Get in touch <Icon name="fa6-solid:arrow-right" class="text-xs" /></a>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-5 pb-24 pt-6 text-xs text-cream/60 sm:flex-row sm:items-center sm:justify-between sm:pb-6 sm:pr-24">
      <p>© {new Date().getFullYear()} Yucca Homeware. Made with care in Kenya.</p>
      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Legal"><a class="hover:text-wheat" href="/privacy">Privacy policy</a><a class="hover:text-wheat" href="/terms">Terms of use</a><a class="hover:text-wheat" href="/contact">Contact</a></nav>
    </div>
  </div>
</footer>
<a href="#top" id="back-to-top" class="back-to-top" aria-label="Back to top"><Icon name="fa6-solid:arrow-up" /></a>
