---
import { statusLabel, statusTone } from '~/lib/labels';

interface Props { status: string }
const { status } = Astro.props;
---
<span class:list={['inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-2.5 py-1 text-xs font-semibold', statusTone(status)]}><span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>{statusLabel(status)}</span>
