---
import Icon from './Icon.astro';
import { serviceDetails, serviceImage } from '~/data/service-details';
import { formatMoneyWhole } from '~/lib/money';
import { isConsultationService, type ServiceRow } from '~/lib/services';

interface Props { service: ServiceRow }
const { service } = Astro.props;
const details = serviceDetails(service.slug);
const light = details.theme.text === 'light';
const accent = details.theme.bg;
// 90% keeps secondary text at 5:1 or better on every theme colour (80% dropped below AA on terracotta).
const muted = light ? 'text-white/90' : 'text-ink/90';
const cta = isConsultationService(service)
  ? { label: 'Book this session', href: `/consultations${details.consultationType ? `?type=${encodeURIComponent(details.consultationType)}` : ''}#book`, select: '#consultation-type', value: details.consultationType ?? '' }
  : { label: 'Request a quote', href: '#request-form', select: '#service-id', value: String(service.id) };
const meta = [
  service.duration ? ['fa6-regular:clock', service.duration] : null,
  service.startingPriceCents !== null ? ['fa6-solid:tag', `From ${formatMoneyWhole(service.startingPriceCents)}`] : null,
].filter((item): item is string[] => item !== null);
---
<article class:list={['group flex flex-col overflow-hidden rounded-3xl shadow-xl shadow-ink/15', light ? 'text-white' : 'text-ink']} style={`background-color:${accent}`}>
  <div class="relative aspect-[16/10] overflow-hidden">
    <img src={serviceImage(details.image)} alt={details.imageAlt} loading="lazy" class="h-full w-full object-cover motion-safe:transition motion-safe:duration-700 motion-safe:group-hover:scale-105" />
    <span class="absolute inset-0 bg-gradient-to-t from-black/45 via-transparent to-transparent"></span>
    <span class="absolute left-5 top-5 rounded-full bg-white/90 px-3 py-1 text-[10px] font-semibold uppercase tracking-[.18em] text-ink">{service.categoryName ?? 'Yucca service'}</span>
  </div>
  <div class="relative flex flex-1 flex-col p-6 sm:p-8">
    <span class="absolute -top-7 right-6 grid h-14 w-14 place-items-center rounded-2xl bg-white text-xl shadow-lg" style={`color:${light ? accent : '#2A2B25'}`}><Icon name={details.icon} /></span>
    <h3 class="pr-16 font-serif text-2xl sm:text-3xl">{service.name}</h3>
    {details.tagline && <p class="mt-1 text-sm font-semibold">{details.tagline}</p>}
    <p class="mt-4 text-[15px] leading-7">{service.description}</p>
    {details.story && <p class:list={['mt-3 text-sm leading-7', muted]}>{details.story}</p>}
    {details.includes.length > 0 && (
      <>
        <p class:list={['mt-6 text-[11px] font-semibold uppercase tracking-[.2em]', muted]}>What’s included</p>
        <ul class="mt-3 grid gap-2.5 text-sm leading-6">
          {details.includes.map((item) => <li class="flex gap-3"><Icon name="fa6-solid:circle-check" class="mt-1 shrink-0" /><span>{item}</span></li>)}
        </ul>
      </>
    )}
    {details.ideal && <p class:list={['mt-6 rounded-2xl p-4 text-xs leading-5', light ? 'bg-white/10' : 'bg-black/10']}><strong class="font-semibold">Ideal for:</strong> {details.ideal}</p>}
    <div class="mt-auto flex flex-wrap items-center justify-between gap-4 pt-7">
      <div class="flex flex-wrap gap-2 text-xs">
        {meta.map(([icon, label]) => <span class:list={['inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5', light ? 'border-white/35' : 'border-ink/25']}><Icon name={icon!} />{label}</span>)}
      </div>
      <a href={cta.href} data-fill-select={cta.select} data-fill-value={cta.value} class:list={['inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold shadow-md transition hover:-translate-y-0.5', light ? 'bg-white' : 'bg-ink text-white']} style={light ? `color:${accent}` : undefined}>{cta.label} <Icon name="fa6-solid:arrow-right" class="text-xs" /><span class="sr-only"> for {service.name}</span></a>
    </div>
  </div>
</article>
