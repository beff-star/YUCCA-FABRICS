---
import { actions } from 'astro:actions';
import Icon from './Icon.astro';
import Price from './Price.astro';
import { PRODUCT_PLACEHOLDER_IMAGE } from '~/data/fabric-collection';
import type { ProductCardData } from '~/lib/catalogue';

interface Props { product: ProductCardData; removable?: boolean }
const { product, removable = false } = Astro.props;
const href = `/products/${product.slug}`;
const onSale = product.salePriceCents !== null && product.salePriceCents < product.priceCents;
const isCustomer = Astro.locals.user?.role === 'customer';
const rating = product.averageRating === null ? null : Number(product.averageRating).toFixed(1);
---
<article class="group relative flex flex-col overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-ink/5 transition motion-safe:hover:-translate-y-1 hover:shadow-lg" data-removable>
  <a href={href} class="relative block aspect-[4/5] overflow-hidden bg-cream" tabindex="-1" aria-hidden="true">
    <img src={product.image ?? PRODUCT_PLACEHOLDER_IMAGE} alt="" loading="lazy" width="368" height="460" class="h-full w-full object-cover object-top transition duration-700 motion-safe:group-hover:scale-105" />
    {onSale ? <span class="absolute left-3 top-3 rounded-full bg-clay px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-white">Sale</span>
      : product.stock === 0 && <span class="absolute left-3 top-3 rounded-full bg-ink/80 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-white">Sold out</span>}
  </a>
  <div class="flex flex-1 flex-col p-3 sm:p-4">
    <p class="truncate text-[10px] uppercase tracking-[.16em] text-sage">{product.material || product.categoryName || 'Yucca collection'}</p>
    <h3 class="mt-1.5 font-serif text-base leading-snug sm:text-lg"><a href={href}>{product.name}</a></h3>
    {product.colour && <p class="mt-0.5 truncate text-xs text-gray-500">{product.colour}</p>}
    {rating && <p class="mt-1 text-xs text-clay"><span aria-hidden="true">★ {rating} / 5</span><span class="sr-only">Average customer rating {rating} out of 5</span></p>}
    <p class="mt-2 text-sm font-semibold text-forest"><Price priceCents={product.priceCents} salePriceCents={product.salePriceCents} unit={product.unit} /></p>
    <div class="mt-auto flex items-center gap-2 pt-3">
      {product.stock > 0 ? (
        <form method="post" action={actions.cartAdd} data-ajax-form="cartAdd" data-keep class="flex-1">
          <input type="hidden" name="product_id" value={product.id} />
          <input type="hidden" name="quantity" value="1" />
          <button class="w-full rounded-full border border-forest px-3 py-2 text-xs font-semibold text-forest transition hover:bg-forest hover:text-white">Add to bag<span class="sr-only">: {product.name}</span></button>
        </form>
      ) : (
        <a href="/contact" class="flex-1 rounded-full border border-ink/20 px-3 py-2 text-center text-xs font-semibold text-gray-600">Ask about stock</a>
      )}
      {isCustomer && (
        <form method="post" action={actions.wishlist} data-ajax-form="wishlist" data-keep>
          <input type="hidden" name="product_id" value={product.id} />
          <input type="hidden" name="intent" value={removable ? 'remove' : 'add'} />
          <button class="grid h-8 w-8 shrink-0 place-items-center rounded-full text-clay hover:bg-cream" aria-label={`${removable ? 'Remove' : 'Save'} ${product.name} ${removable ? 'from' : 'to'} favourites`}>
            <Icon name={removable ? 'fa6-solid:xmark' : 'fa6-regular:heart'} />
          </button>
        </form>
      )}
    </div>
  </div>
</article>
